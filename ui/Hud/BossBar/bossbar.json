{
  "namespace": "bossbar",
  "BossBar": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [
      "100%",
      "100%"
    ],
    "offset": [
      0,
      -1000
    ],
    "controls": [
      {
        "boss_hud_padding": {
          "type": "panel",
          "size": [
            "100%",
            20
          ],
          "visible": "#boss_hud_padding",
          "bindings": [
            {
              "binding_name": "#boss_hud_padding",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "boss_hud_padding_in": {
          "type": "panel",
          "size": "@hud_anims.bossbar_push_in",
          "$btn": "botton.bossbarOn",
          "animation_reset_name": "$btn",
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "BossBarOn",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "boss_hud_padding_out": {
          "type": "panel",
          "size": "@hud_anims.bossbar_push_out",
          "$btn": "botton.bossbarOff",
          "animation_reset_name": "$btn",
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "BossBarOff",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "boss_hud_panel": {
          "type": "panel",
          "size": [
            "100%",
            0
          ],
          "controls": [
            {
              "boss_health_grid@boss_health_grid": {
                "offset": [
                  0,
                  2
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "boss_name_panel": {
    "type": "panel",
    "size": [
      "100%",
      "100%c"
    ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "controls": [
      {
        "boss_name": {
          "type": "label",
          "color": "$boss_name_text_color",
          "text": "#bossName",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "shadow": true,
          "bindings": [
            {
              "binding_name": "#bossName",
              "binding_type": "collection",
              "binding_collection_name": "boss_bars"
            }
          ]
        }
      }
    ]
  },
  "boss_health_panel": {
    "type": "panel",
    "size": [
      182,
      20
    ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "$progress_bar_collection": "boss_bars",
    "controls": [
      {
        "boss_name@boss_name_panel": {}
      },
      {
        "progress_bar_for_collections@common.progress_bar_for_collections": {
          "offset": [
            0,
            10
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#bar_visible",
        "binding_type": "collection",
        "binding_collection_name": "boss_bars",
        "binding_name_override": "#visible"
      }
    ]
  },
  "boss_health_grid": {
    "type": "grid",
    "grid_dimension_binding": "#boss_grid_dimension",
    "grid_item_template": "bossbar.boss_health_panel",
    "grid_fill_direction": "vertical",
    "collection_name": "boss_bars",
    "anchor_to": "top_middle",
    "anchor_from": "top_middle",
    "size": [
      182,
      "30%"
    ]
  }
}