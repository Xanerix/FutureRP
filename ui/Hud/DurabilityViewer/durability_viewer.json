{
	"namespace": "durability",
	"durability_value": {
		"type": "label",
		"text": "#text",
		"font_scale_factor": 0.6,
		"shadow": true,
		"font_type": "$global_font_type",
		"color": "$color",
		"bindings": [
			{
				"binding_name": "#slot_selected",
				"binding_type": "collection",
				"binding_collection_name": "hotbar_items"
			},
			{
				"binding_name": "#item_durability_total_amount",
				"binding_type": "collection",
				"binding_collection_name": "hotbar_items"
			},
			{
				"binding_type": "view",
				"source_property_name": "(((#total_num>#item_durability_total_amount)*-1+1)*((#total_num<#item_durability_total_amount)*1+#total_num))",
				"target_property_name": "#total_num"
			},
			{
				"binding_name": "#item_durability_current_amount",
				"binding_type": "collection",
				"binding_collection_name": "hotbar_items"
			},
			{
				"binding_type": "view",
				"source_property_name": "(((#current_num>#item_durability_current_amount)*-1+1)*((#current_num<#item_durability_current_amount)*1+#current_num))",
				"target_property_name": "#current_num"
			},
			{
				"binding_type": "view",
				"source_property_name": "('Durability: '+#current_num+'/'+#total_num)",
				"target_property_name": "#text"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#total_num>0 and #slot_selected)",
				"target_property_name": "#visible"
			}
		]
	},
	"Durability": {
		"type": "stack_panel",
		"collection_name": "hotbar_items",
		"controls": [
			{
				"0@durability_value": {
					"collection_index": 0
				}
			},
			{
				"1@durability_value": {
					"collection_index": 1
				}
			},
			{
				"2@durability_value": {
					"collection_index": 2
				}
			},
			{
				"3@durability_value": {
					"collection_index": 3
				}
			},
			{
				"4@durability_value": {
					"collection_index": 4
				}
			},
			{
				"5@durability_value": {
					"collection_index": 5
				}
			},
			{
				"6@durability_value": {
					"collection_index": 6
				}
			},
			{
				"7@durability_value": {
					"collection_index": 7
				}
			},
			{
				"8@durability_value": {
					"collection_index": 8
				}
			}
		]
	}
}