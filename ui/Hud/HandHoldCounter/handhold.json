{
	"namespace": "handhold",
	"HandHold": {
		"type": "input_panel",
		"prevent_touch_input": true,
		"size": [
			"100%cm",
			"100%cm"
		],
		"offset": [
			0,
			0
		],
		"button_mappings": [
			{
				"from_button_id": "button.menu_select",
				"to_button_id": "button.menu_select",
				"mapping_type": "pressed"
			}
		],
		"draggable": "both",
		"controls": [
			{
				"_": {
					"type": "panel",
					"size": [
						"100%cm",
						"100%cm"
					],
					"bindings": [
						{
							"binding_type": "view",
							"source_control_name": "HandHoldOn",
							"source_property_name": "#toggle_state",
							"target_property_name": "#visible"
						}
					],
					"controls": [
						{
							"_": {
								"type": "panel",
								"size": [
									"100%cm",
									"100%cm"
								],
								"bindings": [
									{
										"binding_type": "view",
										"source_control_name": "item_total_counter",
										"source_property_name": "(not (#Genshin_total_count = 'x1'))",
										"target_property_name": "#visible"
									}
								],
								"controls": [
									{
										"item_counter_content": {
											"type": "image",
											"$counter_item_id": 1,
											"alpha": 0.3,
											"layer": 3,
											"texture": "textures/ui/hud_tip_text_background",
											"$counter_collection_name": "hotbar_items",
											"size": [
												"100%cm + 4px",
												"100%cm + 2px"
											],
											"bindings": [
												{
													"binding_type": "view",
													"source_control_name": "slot_selected_detection_content",
													"source_property_name": "(not (#selected_item_aux = -1))",
													"target_property_name": "#visible"
												}
											],
											"controls": [
												{
													"item_stack": {
														"type": "stack_panel",
														"orientation": "horizontal",
														"size": [
															"100%c",
															"100%cm"
														],
														"controls": [
															{
																"item_renderer": {
																	"type": "custom",
																	"renderer": "inventory_item_renderer",
																	"size": [
																		"100%y",
																		"100%sm"
																	],
																	"layer": 4,
																	"bindings": [
																		{
																			"binding_type": "view",
																			"source_control_name": "slot_selected_detection_content",
																			"source_property_name": "#selected_item_aux",
																			"target_property_name": "#item_id_aux"
																		}
																	]
																}
															},
															{
																"item_total_counter@item_total_counter": {
																	"layer": 4
																}
															}
														]
													}
												}
											]
										}
									}
								]
							}
						}
					]
				}
			}
		]
	},
	"counter_item": {
		"type": "panel",
		"bindings": [
			{
				"binding_name": "#inventory_stack_count",
				"binding_type": "collection",
				"binding_collection_name": "$counter_collection_name"
			},
			{
				"binding_name": "#item_id_aux",
				"binding_type": "collection",
				"binding_collection_name": "$counter_collection_name"
			},
			{
				"binding_type": "view",
				"resolve_sibling_scope": true,
				"source_control_name": "slot_selected_detection_content",
				"source_property_name": "#selected_item_aux",
				"target_property_name": "#items_id_aux"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#item_id_aux = #items_id_aux)",
				"target_property_name": "#is_item_right"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#inventory_stack_count * 1)",
				"target_property_name": "#ItemStackCount"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#inventory_stack_count = 0)",
				"target_property_name": "#OneCount"
			},
			{
				"binding_type": "view",
				"source_property_name": "((#OneCount + #ItemStackCount) * #is_item_right)",
				"target_property_name": "#slot_item_counter"
			}
		]
	},
