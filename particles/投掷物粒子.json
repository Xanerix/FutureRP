{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "fly:particle",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.size = 0.5;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.0
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 2.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.size*(1-variable.particle_age/variable.particle_lifetime)/10",
          "variable.size*(1-variable.particle_age/variable.particle_lifetime)/10"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            16,
            88
          ],
          "uv_size": [
            8,
            8
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.mod(v.particle_age*5+1,6)<=2 ? 1 : (math.mod(v.particle_age*5,6)>2 && math.mod(v.particle_age*5,6)<=4 ? 0 : (math.mod(v.particle_age*5,6)>4 && math.mod(v.particle_age*5,6)<5 ? math.mod(v.particle_age*5,1) : 1-math.mod(v.particle_age*5,-1)))",
          "math.mod(v.particle_age*5,6)>=1 && math.mod(v.particle_age*5,6)<=3 ? 1 : (math.mod(v.particle_age*5,6)>=4 ? 0 : (math.mod(v.particle_age*5,6)>=0 && math.mod(v.particle_age*5,6)<=1 ? math.mod(v.particle_age*5,1) : 1-math.mod(v.particle_age*5,-1)))",
          "math.mod(v.particle_age*5,6)>=0 && math.mod(v.particle_age*5,6)<=2 ? 0 : (math.mod(v.particle_age*5,6)>=3 && math.mod(v.particle_age*5,6)<=5 ? 1 : (math.mod(v.particle_age*5,6)>2 && math.mod(v.particle_age*5,6)<3 ? math.mod(v.particle_age*5,1) : 1-math.mod(v.particle_age*5,-1)))",
          "(1.0-variable.particle_age/variable.particle_lifetime)"
        ]
      }
    }
  }
}