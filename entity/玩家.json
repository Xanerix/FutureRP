				"pre_animation": [
					"variable.enchanted_helmet = (q.armor_material_slot(0) == 1 || q.armor_material_slot(0) == 3);",
					"variable.enchanted_chestplate = (q.armor_material_slot(1) == 1 || q.armor_material_slot(1) == 3);",
					"variable.enchanted_leggings = (q.armor_material_slot(2) == 1 || q.armor_material_slot(2) == 3);",
					"variable.enchanted_boots = (q.armor_material_slot(3) == 1 || q.armor_material_slot(3) == 3);",
					"variable.helmet_layer_visible = 1.0;",
					"variable.leg_layer_visible = 1.0;",
					"variable.boot_layer_visible = 1.0;",
					"variable.chest_layer_visible = 1.0;",
					"variable.attack_body_rot_y = Math.sin(360*Math.sqrt(variable.attack_time)) * 5.0;",
					"variable.tcos0 = (math.cos(q.modified_distance_moved * 38.17) * q.modified_move_speed / variable.gliding_speed_value) * 57.3;",
					"variable.first_person_rotation_factor = math.sin((1 - variable.attack_time) * 180.0);",
					"variable.hand_bob = q.life_time < 0.01 ? 0.0 : variable.hand_bob + ((q.is_on_ground && q.is_alive ? math.clamp(math.sqrt(math.pow(q.position_delta(0), 2.0) + math.pow(q.position_delta(2), 2.0)), 0.0, 0.1) : 0.0) - variable.hand_bob) * 0.02;",
					"variable.map_angle = math.clamp(1 - variable.player_x_rotation / 45.1, 0.0, 1.0);",
					"variable.item_use_normalized = q.main_hand_item_use_duration / q.main_hand_item_max_duration;",
					"variable.lonel_v_pearl_lz_xs = 1.0;",
					"variable.lonel_v_pearl_tp_py = 0.0;",
					"variable.lonel_v_pearl_tp_rj = 1.0;",
					"variable.lonel_v_pearl_tp_rj_sp = 2.0;",
					"variable.lonel_v_pearl_tp_rj_speed = 0.65;",
					"variable.t = q.life_time*0.5;",
					"variable.r = math.mod(variable.t+1,6)<=2 ? 1 : (math.mod(variable.t,6)>2 && math.mod(variable.t,6)<=4 ? 0 : (math.mod(variable.t,6)>4 && math.mod(variable.t,6)<5 ? math.mod(variable.t,1) : 1-math.mod(variable.t,-1)));",
					"variable.g = math.mod(variable.t,6)>=1 && math.mod(variable.t,6)<=3 ? 1 : (math.mod(variable.t,6)>=4 ? 0 : (math.mod(variable.t,6)>=0 && math.mod(variable.t,6)<=1 ? math.mod(variable.t,1) : 1-math.mod(variable.t,-1)));",
					"variable.b = math.mod(variable.t,6)>=0 && math.mod(variable.t,6)<=2 ? 0 : (math.mod(variable.t,6)>=3 && math.mod(variable.t,6)<=5 ? 1 : (math.mod(variable.t,6)>2 && math.mod(variable.t,6)<3 ? math.mod(variable.t,1) : 1-math.mod(variable.t,-1)));",
					"variable.armor_value = variable.armor_value_head+variable.armor_value_chest+variable.armor_value_leg+variable.armor_value_foot;",
					"variable.bow = q.get_equipped_item_name == 'bow';",
					"variable.crossbow = q.get_equipped_item_name == 'crossbow';",
					"variable.trident = q.get_equipped_item_name == 'trident';",
					"variable.shield = q.get_equipped_item_name == 'shield';",
					"variable.spyglass = q.get_equipped_item_name == 'spyglass';"
