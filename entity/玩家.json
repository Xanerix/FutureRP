				},
				{
					"controller.render.player.map": "variable.map_face_icon"
				},
				{
					"controller.render.player.armor.attachable_bones": "q.equipment_count > 0"
				},
				{
					"controller.render.player.armor.attachable_bones_elytra": "q.armor_texture_slot(1) == 5"
				},
				{
					"controller.render.player.armor.attachable_bones_leggings": "q.has_armor_slot(2)"
				},
				{
					"controller.render.player.armor.helmet": "!variable.is_first_person && !variable.map_face_icon && (variable.hurt_time > 0.0f) && q.has_armor_slot(0) && !q.is_invisible && !q.is_emoting"
				},
				{
					"controller.render.player.armor.chestplate": "!variable.is_first_person && !variable.map_face_icon && (variable.hurt_time > 0.0f) && q.has_armor_slot(1) && !q.is_invisible && !q.is_emoting"
				},
				{
					"controller.render.player.armor.leggings": "!variable.is_first_person && !variable.map_face_icon && (variable.hurt_time > 0.0f) && q.has_armor_slot(2) && !q.is_invisible && !q.is_emoting"
				},
				{
					"controller.render.player.armor.boots": "!variable.is_first_person && !variable.map_face_icon && (variable.hurt_time > 0.0f) && q.has_armor_slot(3) && !q.is_invisible && !q.is_emoting"
				},
				{
					"controller.render.item2d.shield": "query.get_equipped_item_name('off_hand') == 'shield' && query.is_in_ui"
				},
				{
					"controller.render.item2d.arrow": "query.get_equipped_item_name('off_hand') == 'arrow' && query.is_in_ui"
				},
				{
					"controller.render.item2d.totem": "query.get_equipped_item_name('off_hand') == 'totem_of_undying' && query.is_in_ui"
				},
				{
					"controller.render.item2d.firework": "query.get_equipped_item_name('off_hand') == 'firework_rocket' && query.is_in_ui"
				},
				{
					"controller.render.item2d.shell": "query.get_equipped_item_name('off_hand') == 'nautilus_shell' && query.is_in_ui"
				},
				{
					"controller.render.item2d.filled_map": "query.get_equipped_item_name('off_hand') == 'filled_map' && query.is_in_ui"
				},
				{
					"controller.render.item2d.helmet": "query.has_armor_slot(0)&&query.is_in_ui"
				},
				{
					"controller.render.item2d.chestplate": "query.has_armor_slot(1)&&query.is_in_ui"
				},
				{
					"controller.render.item2d.leggings": "query.has_armor_slot(2)&&query.is_in_ui"
				},
				{
					"controller.render.item2d.boots": "query.has_armor_slot(3)&&query.is_in_ui"
				},
				{
					"controller.render.target_capsule": "!variable.local_player && variable.capsule && !q.is_in_ui && !variable.is_paperdoll && !variable.is_first_person && !variable.map_face_icon && q.is_alive"
				},
				{
					"controller.render.player.cross": "variable.local_player"
				},
				{
					"controller.render.player.cross2": "variable.local_player"
				},
				{
					"controller.render.player.health_bar": "variable.local_player"
				},
				{
					"controller.render.player.armor_bar": "variable.local_player"
				}
			],
			"enable_attachables": true
		}
	}
}